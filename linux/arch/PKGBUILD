# Maintainer: FabioLukas123
# Bholeynath for Arch Linux — built from the Tauri app in windows/, which runs on
# Windows and Linux alike.

pkgname=bholeynath-git
_pkgname=bholeynath
pkgver=0.5.9
pkgrel=1
pkgdesc="Narayan lives at the top of your screen and keeps an eye on your Claude Code sessions"
arch=('x86_64' 'aarch64')
url="https://github.com/Samir-Khadka/bholeynath"
license=("MIT" "LicenseRef-bholeynath-assets")
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'gtk-layer-shell'
  'libayatana-appindicator'
  'gst-plugins-base'
  'gst-plugins-good'
  'dbus'
  'alsa-lib'
  'xdg-utils'
  'hicolor-icon-theme'
)
optdepends=(
  'gnome-keyring: store API keys (or any other Secret Service provider)'
  'kwallet: store API keys (or any other Secret Service provider)'
  'speech-dispatcher: « OK Bholeynath » answers out loud where the webview has no voice'
  'espeak-ng: « OK Bholeynath » answers out loud where the webview has no voice'
)
makedepends=('git' 'cargo' 'nodejs' 'npm')
provides=("$_pkgname")
conflicts=("$_pkgname")
# makepkg's default LTO and debug flags make the Rust build very slow.
options=('!lto' '!debug')
source=("$_pkgname::git+https://github.com/Samir-Khadka/bholeynath.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  local v
  v=$(sed -n 's/^version = "\(.*\)"/\1/p' windows/Cargo.toml | head -1)
  printf "%s.r%s.%s" "$v" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname/windows"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  npm ci
}

build() {
  cd "$_pkgname/windows"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$PWD/target"
  # beforeBuildCommand builds the front end and the bholeynath-hook relay.
  npx tauri build --no-bundle
}

package() {
  cd "$_pkgname"
  install -Dm755 windows/target/release/bholeynath "$pkgdir/usr/bin/bholeynath"
  # Found next to the app, then copied into ~/.local/share/bholeynath/bin at launch.
  install -Dm755 windows/target/release/bholeynath-hook "$pkgdir/usr/bin/bholeynath-hook"
  install -Dm644 linux/arch/bholeynath.desktop "$pkgdir/usr/share/applications/com.samirkhadka.bholeynath"
  install -Dm644 windows/src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/bholeynath.png"
  install -Dm644 windows/src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/bholeynath.png"
  install -Dm644 windows/src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/bholeynath.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSE-ASSETS.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE-ASSETS.md"
}
